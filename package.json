{
  "name": "ydown",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "desktop": "pnpm --filter @ydown/desktop run dev",
    "mobile": "pnpm --filter @ydown/mobile run start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:typescript && pnpm run test:media-tools",
    "build": "pnpm --filter @ydown/desktop run build",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:build": "pnpm --filter @ydown/desktop run bundle",
    "desktop:preview": "pnpm --filter @ydown/desktop run dev:ui",
    "media:prepare": "python3 scripts/fetch-media-tools.py",
    "test:typescript": "vitest run",
    "test:media-tools": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "test:architecture": "vitest run scripts/architecture/tests"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.25.0"
  }
}
